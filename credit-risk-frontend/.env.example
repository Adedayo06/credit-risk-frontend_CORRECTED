# Copy this file to .env.local for local overrides, or set these in your
# Vercel project settings (Settings -> Environment Variables) for production.
#
# Local dev normally doesn't need these at all — vite.config.ts proxies
# "/api" and "/api/batch" to localhost:8000/8001 automatically. They're
# required for a production build (e.g. on Vercel), since there's no dev
# server there to proxy through.

# credit-risk-api's deployed URL (Render)
VITE_MODEL_API_URL=https://credit-risk-model-api.onrender.com

# batch-api's deployed URL (Render)
VITE_BATCH_API_URL=https://credit-risk-batch-api.onrender.com
